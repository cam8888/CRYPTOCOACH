{
  "expo": {
    "name": "CryptoCoach",
    "slug": "cryptocoach",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon.png",
    "scheme": "cryptocoach",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/app-icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1E28B8",
        "foregroundImage": "./assets/images/fox.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1E28B8",
          "image": "./assets/images/fox.png",
          "imageWidth": 160
        }
      ],
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
